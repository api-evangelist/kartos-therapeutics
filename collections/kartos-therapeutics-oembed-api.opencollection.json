{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kartos Therapeutics Content Oembed API",
    "version": "2"
  },
  "items": [
    {
      "info": {
        "name": "oembed",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get an oEmbed response for a kartosthera.com URL",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://kartosthera.com/wp-json/oembed/1.0/embed",
            "params": [
              {
                "name": "url",
                "value": "https://kartosthera.com/science/",
                "type": "query",
                "description": "The kartosthera.com URL to embed."
              },
              {
                "name": "format",
                "value": "",
                "type": "query"
              },
              {
                "name": "maxwidth",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "The oEmbed 1.0 provider endpoint. Returns provider name, author, title and embeddable HTML for any published kartosthera.com URL. Verified against the /science/ page."
        }
      ]
    }
  ],
  "bundled": true
}